# Everything this firmware needs beyond ESP-IDF's defaults. A fresh clone
# builds the same firmware from this file alone: `idf.py build` generates
# sdkconfig from it (delete sdkconfig first to regenerate from scratch).

# ---- Flash: the ESP32-WROOM module has 4 MB. The app (Bluetooth HFP +
# A2DP + PBAP, display, touch) is ~1 MB, which is too tight for the default
# 1 MB partition, so use the 1.5 MB single-app layout.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# ---- Classic Bluetooth only (no BLE), Bluedroid host
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_BR_EDR_MAX_SYNC_CONN=1
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y

# Hands-free (calls): mic -> phone and caller -> speaker.
CONFIG_BT_HFP_ENABLE=y
CONFIG_BT_HFP_CLIENT_ENABLE=y
# Call audio over HCI so the app handles PCM itself (I2S mic in, I2S amp
# out) instead of the ESP32's fixed PCM pins and an external codec.
CONFIG_BT_HFP_AUDIO_DATA_PATH_HCI=y

# Phonebook client: caller names on the display.
CONFIG_BT_PBAC_ENABLED=y

# Music: A2DP sink to the speaker, AVRCP for play/pause and track titles.
CONFIG_BT_A2DP_ENABLE=y

# ---- Product behaviour (main/Kconfig.projbuild)
# Name phones see when pairing.
CONFIG_EXAMPLE_LOCAL_DEVICE_NAME="ESP_HFP_HF"
# No phone is hard-coded: at power-on the board reconnects to the phone that
# connected last (saved in NVS), or any paired phone. To pin one phone, set
# CONFIG_EXAMPLE_PEER_DEVICE_ADDR="xx:xx:xx:xx:xx:xx".
CONFIG_EXAMPLE_PEER_DEVICE_ADDR=""
CONFIG_EXAMPLE_PEER_DEVICE_NAME=""
